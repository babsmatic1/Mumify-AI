# Get a real key at https://aistudio.google.com/apikey (starts with "AIzaSy...").
# Do NOT use an AI-Studio-injected "AQ...." secret reference here - it only
# resolves inside the AI Studio hosted runtime and will not work locally.
VITE_GEMINI_API_KEY=

# Firebase Web App config. Create a project at https://console.firebase.google.com,
# add a Web App, then copy the values from Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
